# ============================================================
# Unreal Engine 忽略规则
# 只提交源资产与配置，不提交生成的缓存与本地设置
# ============================================================

# 引擎生成目录
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# 编译产物
*.VC.db
*.opensdf
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace
*.pdb

# IDE / 编辑器本地设置
.vs/
.vscode/
.idea/
*.user
*.userprefs

# 本地自动备份
*.autosave

# 第三方 Unreal MCP 插件（由 Tools/Install-MonolithMCP.ps1 安装）
LanRan/Plugins/Monolith/

# 系统文件
Thumbs.db
desktop.ini
.DS_Store
